{
  "name": "mpsi-radjo-inventory",
  "version": "1.0.0",
  "description": "Sistem Informasi Pengelolaan Persediaan Bahan Baku - Cafe Radjo Roastery (Express + MySQL)",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/init-db.js --drop && node scripts/seed.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "mysql2": "^3.9.7"
  }
}
