<%- include('../partials/head') %>
<main class="wrap narrow">
<%- include('../partials/flash') %>
<% const p2 = (n) => String(n).padStart(2,'0'); const d = now; const iso = d.getFullYear()+'-'+p2(d.getMonth()+1)+'-'+p2(d.getDate()); %>
<div class="page-head"><div><p class="crumb">Transaksi / <b>Pengeluaran Stok</b></p><h1>Pengeluaran Stok Bahan Baku</h1><p>Catat bahan yang diambil untuk racikan menu kafe atau bahan terbuang (waste)</p></div></div>
<form class="card formcard" id="form-keluar" method="post" action="/transaksi/keluar">
  <div class="meta"><div><small>No. Bukti Keluar</small><b><%= noDok %></b></div><div><small>Waktu Pengambilan</small><b><%= tgl(iso) %> · <%= p2(d.getHours()) %>.<%= p2(d.getMinutes()) %> WIB</b></div><div><small>Pencatat</small><b class="green"><%= user.nama %></b></div></div>
  <div class="grid2">
    <div class="field"><label for="bahan">Pilih Bahan Baku <i>*</i></label><select class="select" id="bahan" name="id_bahan" required><option value="">Pilih bahan</option>
      <% bahan.forEach(b => { %><option value="<%= b.id_bahan %>" data-stok="<%= b.stok_saat_ini %>" data-min="<%= b.stok_minimum %>" data-satuan="<%= b.satuan_pakai %>" data-nama="<%= b.nama_bahan %>" <%= String(v('id_bahan'))===String(b.id_bahan)?'selected':'' %>><%= b.nama_bahan %> (Tersedia: <%= num(b.stok_saat_ini) %> <%= b.satuan_pakai %>)</option><% }) %></select></div>
    <div class="field"><label for="jenis">Tujuan Pengeluaran <i>*</i></label><select class="select" id="jenis" name="jenis_keluar" required>
      <% [['pemakaian','Operasional / Racikan Minuman Bar'],['rusak','Bahan Rusak'],['kedaluwarsa','Bahan Kedaluwarsa']].forEach(o => { %><option value="<%= o[0] %>" <%= v('jenis_keluar','pemakaian')===o[0]?'selected':'' %>><%= o[1] %></option><% }) %></select></div>
    <div class="field"><label for="jumlah">Jumlah Keluar <i>*</i></label><div class="unit"><input class="input" id="jumlah" name="jumlah_keluar" inputmode="decimal" value="<%= v('jumlah_keluar') %>" required autofocus><span class="tag" id="unit">-</span></div><p class="hint">Dalam satuan pakai. Diambil dari batch kedaluwarsa paling awal (FEFO).</p></div>
    <div class="field"><label>Sisa Stok Akhir</label><input class="input calc" id="sisa" readonly tabindex="-1"></div>
    <div class="field full"><label for="ket">Keterangan Tambahan / Shift Kerja</label><input class="input" id="ket" name="keterangan" value="<%= v('keterangan') %>"></div>
  </div>
  <div class="callout warn" id="warn" hidden><span class="dot">!</span><div><b>Peringatan Ambang Batas Minimum</b><small id="warn-text"></small></div></div>
  <div class="form-actions"><a class="btn" href="/">Batal</a><button class="btn primary" type="submit">Simpan Pengeluaran</button></div>
</form>
</main>
<%- include('../partials/foot') %>
